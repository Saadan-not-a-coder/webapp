generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core User model
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String    // NEW: Added for authentication
  role      Role      @default(STUDENT)
  quizzes   Quiz[]    // Teacher's created quizzes
  attempts  Attempt[] // Student's attempts
  results   Result[]  // Teacher's graded results
}

enum Role {
  STUDENT
  TEACHER
}

// === WORKFLOW 1: TEACHER (Quiz Creation) ===
model Quiz {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  duration    Int        // Stored in minutes
  totalMarks  Int
  isPublished Boolean    @default(false)
  creatorId   Int
  creator     User       @relation(fields: [creatorId], references: [id])
  questions   Question[]
  attempts    Attempt[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Question {
  id            Int      @id @default(autoincrement())
  text          String
  options       String[] // Array of multiple choice options
  correctAnswer String
  points        Int      @default(1)
  quizId        Int
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// === WORKFLOW 2: STUDENT (Quiz Attempt) ===
model Attempt {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  quizId    Int
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers   Answer[]
  result    Result?
  startTime DateTime @default(now())
  status    String   @default("IN_PROGRESS") // e.g., IN_PROGRESS, SUBMITTED
}

model Answer {
  id           Int      @id @default(autoincrement())
  attemptId    Int
  attempt      Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   Int
  selectedText String   // The student's chosen answer
}

// === WORKFLOW 3: TEACHER (Analytics & Grading) ===
model Result {
  id         Int      @id @default(autoincrement())
  attemptId  Int      @unique
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  score      Float
  gradedById Int?
  gradedBy   User?    @relation(fields: [gradedById], references: [id])
  gradedAt   DateTime @default(now())
}