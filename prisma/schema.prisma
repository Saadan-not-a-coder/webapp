generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core User model
model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  password String    
  role     Role      @default(STUDENT)
  quizzes  Quiz[]    
  attempts Attempt[] 
  results  Result[]  
}

enum Role {
  STUDENT
  TEACHER
}

// NEW: For Workflow 1
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// === WORKFLOW 1: TEACHER (Quiz Creation) ===
model Quiz {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  duration     Int        
  totalMarks   Int
  isPublished  Boolean    @default(false)
  
  // NEW: Workflow 1 & Kahoot Requirements
  isRandomized Boolean    @default(false)
  isKahootMode Boolean    @default(false)
  openTime     DateTime?  // Specific Time Windows
  closeTime    DateTime?  
  passingScore Float?     // Required to calculate "Failure Rate"
  
  creatorId    Int
  creator      User       @relation(fields: [creatorId], references: [id])
  questions    Question[]
  attempts     Attempt[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Question {
  id            Int        @id @default(autoincrement())
  text          String
  options       String[] 
  correctAnswer String
  points        Int        @default(1)
  difficulty    Difficulty @default(MEDIUM)
  isBank        Boolean    @default(false)
  
  // NEW: Per-question timer for Kahoot mode
  timeLimit     Int        @default(30) 
  
  quizId        Int?       
  quiz          Quiz?      @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// === WORKFLOW 2: STUDENT (Quiz Attempt) ===
model Attempt {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id])
  quizId    Int
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers   Answer[]
  result    Result?
  startTime DateTime @default(now())
  status    String   @default("IN_PROGRESS") 
}

model Answer {
  id           Int      @id @default(autoincrement())
  attemptId    Int
  attempt      Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   Int
  selectedText String   
  
  // NEW: Analytics & Kahoot Requirements
  isCorrect    Boolean? // Makes it easier for teachers to review individual answers
  timeTaken    Int?     // Tracks how fast they answered for Kahoot mode scoring
}

// === WORKFLOW 3: TEACHER (Analytics & Grading) ===
model Result {
  id               Int      @id @default(autoincrement())
  attemptId        Int      @unique
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  score            Float
  
  // NEW: Workflow 3 Requirement
  manualScore      Float?   // Stores the Teacher's manual mark adjustment
  
  gradedById       Int?
  gradedBy         User?    @relation(fields: [gradedById], references: [id])
  gradedAt         DateTime @default(now())
}